{
  "name": "zoom-connect",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vp build",
    "build-storybook": "storybook build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vp dev",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "cd .. && just serve",
    "storybook": "storybook dev -p 6006",
    "test": "vp run test:unit --run",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.59.0",
    "@skgo/sveltekit-adapter": "file:../tools/skgo-v0.34.3/adapter",
    "@storybook/addon-svelte-csf": "latest",
    "@storybook/sveltekit": "10.6.1",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "5.0.1",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "mode-watcher": "^1.1.0",
    "playwright": "^1.60.0",
    "shadcn-svelte": "^1.7.0",
    "storybook": "10.6.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.1",
    "vitest-browser-svelte": "3.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
