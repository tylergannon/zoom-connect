# From the Zoom Marketplace app (Develop → Build App → General App, user-managed)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# "Secret Token" under Features → Access → Event Subscriptions
ZOOM_WEBHOOK_SECRET=

# rtmsrec options
LISTEN_ADDR=:8080
REC_DIR=recordings
# any of: audio,video,deskshare,transcript,chat  (each needs its scope)
RTMS_MEDIA=transcript,chat
# l16 | opus  — Opus is what nlspec §5.3 assumes; confirm Zoom honours it
RTMS_AUDIO_CODEC=opus
# separate | mixed
RTMS_AUDIO_DATA_OPT=separate
# ask Zoom to buffer up to 60 s while we connect
RTMS_BUFFER_DATA=true

# Optional local bridge: display actual RTMS text in the web prototype.
# Create a key as the demo viewer who should have access to those calls.
ZOOM_CONNECT_URL=http://127.0.0.1:8080
ZOOM_CONNECT_KEY=

# Zoom Connect POC app
DATABASE_URL=postgres://zoom:zoom@127.0.0.1:5432/zoom_connect?sslmode=disable
PUBLIC_URL=http://127.0.0.1:8080
ALLOWED_DOMAIN=acme.co
SESSION_SECRET=local-development-only-change-me-32-bytes-minimum
ADMIN_EMAILS=dana@acme.co,marcus@acme.co
